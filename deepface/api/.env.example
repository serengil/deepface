DEEPFACE_DATABASE_TYPE=postgres # postgres, mongo, weaviate, sqlite, oracle, mssql, db2, redis, cassandra, mysql
DEEPFACE_CONNECTION_DETAILS=
# weaviate accepts a url or a JSON object with connection options, e.g.
# DEEPFACE_CONNECTION_DETAILS={"url": "http://localhost:8080", "grpc_port": 50051}
# DEEPFACE_CONNECTION_DETAILS={"url": "https://my-cluster.weaviate.cloud", "api_key": "..."}
# DEEPFACE_WEAVIATE_TENANT=customer-42 # isolates the faces this service registers and searches
# DEEPFACE_WEAVIATE_QUANTIZATION=rq # rq, rq-1, bq, sq, pq or none, applied to new collections

# set models here with commas to load on app start up, otherwise they will load in the 1st request and respond slower
DEEPFACE_FACE_RECOGNITION_MODELS=VGG-Face,Facenet
DEEPFACE_FACE_DETECTION_MODELS=mtcnn

# activate DEEPFACE_AUTH_TOKEN to enable bearer token
# DEEPFACE_AUTH_TOKEN=